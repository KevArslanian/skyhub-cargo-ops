generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "__DATABASE_PROVIDER__"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  staff
  customer
}

enum UserStatus {
  active
  invited
  disabled
}

enum CustomerAccountStatus {
  active
  disabled
}

enum ShipmentStatus {
  received
  sortation
  loaded_to_aircraft
  departed
  arrived
  hold
}

enum FlightStatus {
  on_time
  delayed
  departed
}

enum BlobCleanupStatus {
  pending
  deleted
  failed
}

model CustomerAccount {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  status       CustomerAccountStatus @default(active)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  users        User[]
  shipments    Shipment[]
}

model City {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  province  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  airports  Airport[]
}

model Airport {
  id                         String     @id @default(cuid())
  code                       String     @unique
  name                       String
  cityId                     String
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  city                       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  originFlights              Flight[]   @relation("FlightOriginAirport")
  destinationFlights         Flight[]   @relation("FlightDestinationAirport")
  originShipments            Shipment[] @relation("ShipmentOriginAirport")
  destinationShipments       Shipment[] @relation("ShipmentDestinationAirport")
  originTariffs              Tariff[]   @relation("TariffOriginAirport")
  destinationTariffs         Tariff[]   @relation("TariffDestinationAirport")

  @@index([cityId])
}

model Aircraft {
  id           String   @id @default(cuid())
  name         String   @default("Pesawat Operasional")
  registration String   @unique
  airlineCode  String
  type         String
  capacityKg   Int
  status       String   @default("Aktif")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  flights      Flight[]
}

model Commodity {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  category  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  shipments Shipment[]
  cargoItems CargoItem[]
}

model Tariff {
  id                   String     @id @default(cuid())
  code                 String     @unique
  originAirportId      String
  destinationAirportId String
  serviceType          String
  pricePerKg           Int
  minimumCharge        Int
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  originAirport        Airport    @relation("TariffOriginAirport", fields: [originAirportId], references: [id], onDelete: Restrict)
  destinationAirport   Airport    @relation("TariffDestinationAirport", fields: [destinationAirportId], references: [id], onDelete: Restrict)
  shipments            Shipment[]

  @@index([originAirportId, destinationAirportId])
}

model CargoItem {
  id          String         @id @default(cuid())
  sku         String         @unique
  name        String
  commodityId String
  unit        String         @default("pcs")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  commodity   Commodity      @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  shipments   ShipmentItem[]

  @@index([commodityId])
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  passwordHash      String
  role              UserRole
  station           String
  status            UserStatus        @default(active)
  customerAccountId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  settings          UserSetting?
  notifications     Notification[]
  activityLogs      ActivityLog[]
  recentAwbSearches RecentAwbSearch[]
  createdShipments  Shipment[]        @relation("ShipmentCreator")
  customerAccount   CustomerAccount?  @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  @@index([role, status])
  @@index([customerAccountId])
}

model UserSetting {
  userId                 String   @id
  theme                  String   @default("light")
  compactRows            Boolean  @default(false)
  sidebarCollapsed       Boolean  @default(false)
  cutoffAlert            Boolean  @default(true)
  exceptionAlert         Boolean  @default(true)
  soundAlert             Boolean  @default(false)
  emailDigest            Boolean  @default(false)
  autoRefresh            Boolean  @default(true)
  refreshIntervalSeconds Int      @default(5)
  timezone               String   @default("Asia/Makassar")
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Flight {
  id              String       @id @default(cuid())
  flightNumber    String       @unique
  aircraftType    String
  origin          String
  destination     String
  departureTime   DateTime
  arrivalTime     DateTime
  cargoCutoffTime DateTime
  status          FlightStatus
  gate            String?
  remarks         String?
  imageUrl        String?
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  aircraftId      String?
  originAirportId String?
  destinationAirportId String?
  aircraft        Aircraft?    @relation(fields: [aircraftId], references: [id], onDelete: SetNull)
  originAirport   Airport?     @relation("FlightOriginAirport", fields: [originAirportId], references: [id], onDelete: SetNull)
  destinationAirport Airport?  @relation("FlightDestinationAirport", fields: [destinationAirportId], references: [id], onDelete: SetNull)
  shipments       Shipment[]

  @@index([archivedAt, status])
  @@index([departureTime])
  @@index([cargoCutoffTime])
  @@index([aircraftId])
  @@index([originAirportId])
  @@index([destinationAirportId])
}

model Shipment {
  id              String            @id @default(cuid())
  awb             String            @unique
  sentAt          DateTime          @default(now())
  commodity       String
  cargoMode       String            @default("Udara")
  senderPhone     String            @default("")
  origin          String
  destination     String
  pieces          Int
  weightKg        Float
  volumeM3        Float?
  specialHandling String?
  serviceType     String            @default("Biasa")
  shippingRate    Int               @default(0)
  vehicleName     String            @default("")
  vehicleType     String            @default("Pesawat")
  vehicleCode     String            @default("")
  vehicleCapacityKg Int             @default(0)
  vehicleStatus   String            @default("Aktif")
  goodsStatus     String            @default("Diproses")
  transactionStatus String          @default("Pending")
  docStatus       String            @default("Complete")
  readiness       String            @default("Ready")
  shipper         String
  consignee       String
  forwarder       String
  ownerName       String
  notes           String?
  status          ShipmentStatus
  receivedAt      DateTime          @default(now())
  archivedAt      DateTime?
  updatedAt       DateTime          @updatedAt
  flightId        String?
  createdById     String?
  customerAccountId String?
  commodityId     String?
  originAirportId String?
  destinationAirportId String?
  tariffId        String?
  flight          Flight?           @relation(fields: [flightId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("ShipmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount?  @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  commodityMaster Commodity?        @relation(fields: [commodityId], references: [id], onDelete: SetNull)
  originAirport   Airport?          @relation("ShipmentOriginAirport", fields: [originAirportId], references: [id], onDelete: SetNull)
  destinationAirport Airport?       @relation("ShipmentDestinationAirport", fields: [destinationAirportId], references: [id], onDelete: SetNull)
  tariff          Tariff?           @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  detail          ShipmentDetail?
  trackingLogs    TrackingLog[]
  documents       ShipmentDocument[]
  shipmentItems   ShipmentItem[]

  @@index([archivedAt, updatedAt])
  @@index([archivedAt, receivedAt])
  @@index([archivedAt, status, updatedAt])
  @@index([customerAccountId, archivedAt, updatedAt])
  @@index([flightId, archivedAt])
  @@index([createdById])
  @@index([commodityId])
  @@index([originAirportId])
  @@index([destinationAirportId])
  @@index([tariffId])
}

model ShipmentDetail {
  id             String   @id @default(cuid())
  shipmentId     String   @unique
  serviceLevel   String
  packagingType  String
  insuranceValue Int
  declaredValue  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentItem {
  shipmentId    String
  cargoItemId   String
  quantity      Int
  declaredValue Int
  createdAt     DateTime  @default(now())
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  cargoItem     CargoItem @relation(fields: [cargoItemId], references: [id], onDelete: Restrict)

  @@id([shipmentId, cargoItemId])
  @@index([cargoItemId])
}

model TrackingLog {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  message    String
  location   String
  actorName  String?
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
}

model ShipmentDocument {
  id                String             @id @default(cuid())
  shipmentId        String
  fileName          String
  mimeType          String
  fileSize          Int
  storageUrl        String
  storageKey        String?
  deletedAt         DateTime?
  blobCleanupStatus BlobCleanupStatus?
  createdAt         DateTime           @default(now())
  shipment          Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, deletedAt])
}

model SystemKpi {
  id             String   @id @default("global")
  platformUptime Float    @default(99.98)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  targetType  String
  targetId    String?
  targetLabel String
  description String
  level       String   @default("info")
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  href      String?
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model RecentAwbSearch {
  id        String   @id @default(cuid())
  userId    String
  awb       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([awb])
}
